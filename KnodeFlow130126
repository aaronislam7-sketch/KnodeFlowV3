  color: #065f46;
  animation: optionCorrect 400ms ease-out;
}

.quiz-option.correct::before,
.kn-mcq-option--correct::before {
  content: '✓';
  position: absolute;
  left: 1.25rem;
  font-size: 1.25rem;
  color: var(--knode-success, #10b981);
  font-weight: 700;
  animation: checkPop 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

